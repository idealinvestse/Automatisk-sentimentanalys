# Pilot / production-like environment template
# Copy to .env and fill secrets. See docs/PILOT_RUNBOOK.md
# Verify: python scripts/verify_pilot_policy.py --strict

API_PRODUCTION=true
API_REQUIRE_AUTH=true
API_REQUIRE_MEDIA_ROOT=true
API_MEDIA_ROOT=/var/sentiment/media
SENTIMENT_API_KEY=replace-with-strong-key

API_CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_RPM=120
API_MAX_UPLOAD_SIZE_MB=200
API_UPLOAD_RETENTION_DAYS=7

# Multi-worker / live WS — required for uvicorn --workers > 1
API_USE_REDIS_CACHE=true
REDIS_URL=redis://localhost:6379/0
API_CACHE_DIR=.cache/aggregates
API_STATE_DIR=.cache/aggregates

OPENROUTER_API_KEY=
# GROQ_API_KEY=          # leave unset for PII pilot
# DEEPGRAM_API_KEY=      # leave unset for PII pilot

SENTIMENT_JSON_LOGS=1
OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example/v1/traces
SENTIMENT_DEV=false
API_TRUSTED_PROXY=false
LOG_LEVEL=INFO
