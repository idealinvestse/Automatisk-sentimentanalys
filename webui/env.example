# --- Preferred: BFF proxy (API key stays on the Next.js server) ---
# NEXT_PUBLIC_USE_API_PROXY=1
# SENTIMENT_API_BASE_URL=http://localhost:8000
# SENTIMENT_API_KEY=<same-as-backend>
# Still set public API base for WebSocket (WS is not proxied):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Legacy trusted-LAN (key visible in browser) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=

# Optional alias (same as NEXT_PUBLIC_API_KEY)
# NEXT_PUBLIC_SENTIMENT_API_KEY=

# Force demo transcripts even when localStorage has real calls
# NEXT_PUBLIC_FORCE_DEMO_DATA=1
