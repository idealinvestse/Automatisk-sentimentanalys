# Default: BFF proxy (API key stays on the Next.js server)
NEXT_PUBLIC_USE_API_PROXY=1
SENTIMENT_API_BASE_URL=http://localhost:8000
SENTIMENT_API_KEY=
# Public origin for WebSocket (WS is not proxied through the BFF)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_WS_API_BASE_URL=http://localhost:8000

# Legacy trusted-LAN (key visible in the browser bundle)
# NEXT_PUBLIC_USE_DIRECT_API=1
# NEXT_PUBLIC_API_KEY=

# Force demo transcripts even when localStorage has real calls (1/true/yes)
# NEXT_PUBLIC_FORCE_DEMO_DATA=1
