# FastAPI base URL (browser-reachable). Baked into Next.js at build time for Docker.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Same value as backend SENTIMENT_API_KEY when API auth is enabled.
# Visible in the browser — use only on trusted networks / internal pilots.
# Prefer a Next.js BFF later for public internet deployments.
NEXT_PUBLIC_API_KEY=

# Optional alias (same as NEXT_PUBLIC_API_KEY)
# NEXT_PUBLIC_SENTIMENT_API_KEY=

# Force demo transcripts even when localStorage has real calls
# NEXT_PUBLIC_FORCE_DEMO_DATA=1
