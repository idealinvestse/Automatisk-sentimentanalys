# Production / pilot webui env
#
# Preferred (hides API key from the browser): use the Next.js BFF proxy.
# Leave NEXT_PUBLIC_API_BASE_URL empty or set to same-origin; set server-only keys.

# Browser calls same-origin /api/backend/* (BFF injects X-API-Key)
NEXT_PUBLIC_USE_API_PROXY=1
# Public base for health probes that must hit the API directly (optional)
# NEXT_PUBLIC_API_BASE_URL=

# Server-only (never NEXT_PUBLIC_*) — used by webui/src/app/api/backend/[...path]/route.ts
SENTIMENT_API_BASE_URL=http://localhost:8000
SENTIMENT_API_KEY=replace-with-same-as-backend

# Legacy trusted-LAN fallback (exposes key in browser bundle — avoid on public internet)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_API_KEY=
