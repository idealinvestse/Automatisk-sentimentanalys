# Swedish Sentiment Analysis — Environment Variables Template
#
# Copy to .env and fill in real values. NEVER commit .env to git.
# Only .env.example is tracked (see .gitignore).

# --- LLM API Keys ---
# OpenRouter (default LLM provider for pipeline + Fas 4)
OPENROUTER_API_KEY=
# Mistral (alternative provider)
MISTRAL_API_KEY=
# Groq (low-latency provider — US/Saudi datacenter, see GDPR gate)
# PILOT/PROD POLICY: leave unset. Dev/lab only. verify_pilot_policy.py --strict fails if set with API_PRODUCTION=true.
GROQ_API_KEY=

# --- Hugging Face (diarization / WhisperX models) ---
HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=

# --- API Security ---
# API authentication key (clients send X-API-Key header). Required when
# API_PRODUCTION or API_REQUIRE_AUTH is true.
SENTIMENT_API_KEY=
# Comma-separated list of allowed CORS origins (e.g. http://localhost:3000)
API_CORS_ORIGINS=http://localhost:3000
# Allow clients to pass LLM API key in request body (default: false)
API_ALLOW_CLIENT_LLM_KEY=false

# --- Production Guards ---
# Master switch: enables all production requirements (auth + media root)
API_PRODUCTION=false
# Require SENTIMENT_API_KEY for all authenticated endpoints
API_REQUIRE_AUTH=false
# Require API_MEDIA_ROOT for file-based operations
API_REQUIRE_MEDIA_ROOT=false
# Root directory for media files (audio uploads, etc.)
API_MEDIA_ROOT=

# --- Rate Limiting ---
# Requests per minute per client (0 = disabled)
API_RATE_LIMIT_RPM=0

# --- Caching ---
# Use Redis for multi-worker aggregate cache (default: file-based)
API_USE_REDIS_CACHE=false
# Redis connection URL (when API_USE_REDIS_CACHE=true)
REDIS_URL=redis://localhost:6379/0
# Cache directory for file-based aggregate cache
API_CACHE_DIR=.cache/aggregates
# State directory for alerting state and process events
API_STATE_DIR=.cache/aggregates

# --- Observability ---
# Enable structured JSON logging (for ELK/Loki/CloudWatch aggregation)
SENTIMENT_JSON_LOGS=0
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Enable dev mode (verbose error responses — DO NOT enable in production)
SENTIMENT_DEV=false
# Enable OpenTelemetry tracing (requires opentelemetry-sdk package)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sentiment-api

# --- Status / Process Events ---
# Disable status event file writing (default: enabled)
SENTIMENT_STATUS_FILE=1
# Max bytes for status event ring buffer file
SENTIMENT_STATUS_FILE_MAX_BYTES=5242880
# Ring buffer size (number of events)
SENTIMENT_STATUS_RING_SIZE=1000

# --- Trusted Proxy ---
# Trust X-Forwarded-For/X-Real-IP headers (enable behind reverse proxy)
API_TRUSTED_PROXY=false

# --- Cloud STT (opt-in only; PILOT/PROD: leave unset for PII calls) ---
# DEEPGRAM_API_KEY=
# CLOUD_STT_API_KEY=

# --- Pilot policy ---
# See docs/PILOT_RUNBOOK.md and run: python scripts/verify_pilot_policy.py
# For production-like pilot: API_PRODUCTION=true + SENTIMENT_API_KEY + API_MEDIA_ROOT
# Keep GROQ_API_KEY and DEEPGRAM_API_KEY unset for customer PII workloads.
#
# Webui (trusted LAN only): set the same key in webui/.env.local as NEXT_PUBLIC_API_KEY
# or pass SENTIMENT_API_KEY into docker compose webui build args (baked at build time).

# --- Multi-provider LLM (optional fallbacks; prefer configs/*.key) ---
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=
# CEREBRAS_API_KEY=
# LLM_ROUTER_PROFILE=free_sequential
