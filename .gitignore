# =============================================================================
# Automatisk-sentimentanalys — .gitignore
# Python 3.11+ · FastAPI · Next.js webui · ASR/ML · Windows launcher
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & environment (never commit real credentials)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local

.secrets/
secrets/
*.secret
*.secrets
*.pem
*.p12
*.pfx
*.token
*.auth

# Explicit key files (allow *.key.example templates)
*.key
!*.key.example
!**/*.key.example
configs/openrouter.key
openrouter.key
OPENROUTER_API_KEY.txt

# Cloud credential dirs / service accounts
.aws/
.gcp/
.azure/
credentials.json
credentials*.json
serviceAccount*.json
service-account*.json
*-credentials.json

# -----------------------------------------------------------------------------
# Python — bytecode, venv, packaging
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
.venv/
venv/
env/
ENV/
.env.bak/
venv.bak/
python/
.python-version.bak

*.egg-info/
.eggs/
dist/
build/
*.egg
*.whl
pip-wheel-metadata/
MANIFEST
*.manifest

# PyInstaller (keep Inno .iss tracked; ignore generated specs if local)
*.pyinstaller.spec

# -----------------------------------------------------------------------------
# IDE / editors / local agent tooling
# -----------------------------------------------------------------------------
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.vs/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.history/
.cursor/
!.cursor/rules/

# Local agent / compound-engineering scratch (not project docs)
agent-tools/
.superpowers/
.playwright-mcp/
.compound-engineering/cache/

# -----------------------------------------------------------------------------
# OS junk
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak
*.orig
*.rej

# -----------------------------------------------------------------------------
# Testing, lint, typecheck, coverage
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.benchmarks/
.hypothesis/
.pytype/
.pyre/
.ty/

# -----------------------------------------------------------------------------
# Jupyter
# -----------------------------------------------------------------------------
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Project runtime — caches, state, logs, outputs
# -----------------------------------------------------------------------------
outputs/
results/
runs/
state/
backups/
*.log
*.log.*
logs/

cache/
.cache/
.cache_dir/
hf_cache/
transformers_cache/
torch_cache/
.huggingface/
.whisper/
.whisperx/
.xtts/
wandb/
mlruns/
lightning_logs/
.neptune/
.comet/

# Job / local DB stores
*.sqlite
*.sqlite3
*.db
!data/**/*.db.example

# -----------------------------------------------------------------------------
# ML artifacts (download or train locally; never commit weights)
# -----------------------------------------------------------------------------
models/
checkpoints/
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.safetensors
*.h5
*.keras
*.joblib
*.pkl
*.pickle

# -----------------------------------------------------------------------------
# DATA-01 — real / imported domain corpora (gitignored slot)
# -----------------------------------------------------------------------------
data/import/*
!data/import/.gitkeep
data/*_real.csv
data/*_real.jsonl
data/**/*_real.csv
data/**/*_real.jsonl

# Large or local-only media (keep manifests, README, sidecars, .gitkeep)
samples/audio/Actor_*/
samples/audio/**/*.wav
samples/audio/**/*.mp3
samples/audio/**/*.flac
samples/audio/**/*.ogg
samples/audio/**/*.m4a
samples/audio/**/*.webm
# Committed L7 synthetic smoke fixture (no PII)
!samples/audio/sv/callcenter/smoke_sv_billing.wav
# Sidecar metadata is small and must stay tracked
!samples/audio/**/*.meta.yaml

# Runtime API uploads (API_MEDIA_ROOT); never commit customer audio
media/uploads/
!media/uploads/.gitkeep

# Local user overrides (templates stay tracked under installer/templates/)
user_config.yaml
**/user_config.local.yaml

# -----------------------------------------------------------------------------
# Generated / ephemeral eval reports (committed baselines stay tracked)
# -----------------------------------------------------------------------------
reports/llm_quality_smoke.json
reports/llm_human_study_template.md
reports/audio_*.json
reports/offline/
reports/**/*_local.json
reports/**/*_smoke.json
reports/**/*_latest.json
reports/step_c_*.json

# -----------------------------------------------------------------------------
# Node / Next.js (webui also has its own .gitignore; root patterns help monorepo)
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
playwright-report/
test-results/
blob-report/
playwright/.cache/

# -----------------------------------------------------------------------------
# Windows installer / portable build outputs
# -----------------------------------------------------------------------------
installer/Output/
installer/dist/
installer/*.exe
installer/*.zip
*.islc

# -----------------------------------------------------------------------------
# Streamlit / misc local UI secrets
# -----------------------------------------------------------------------------
.streamlit/secrets.toml

# -----------------------------------------------------------------------------
# Direnv / mise / asdf local
# -----------------------------------------------------------------------------
.direnv/
.envrc.local

# Multi-provider model catalogs (regenerable)
data/model_catalogs/
data/openrouter_models_catalog.json
